{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Office Hours Consultation Packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "consultation_id",
    "revision",
    "goal",
    "current_state",
    "decision_needed",
    "constraints",
    "attempted",
    "evidence",
    "question",
    "context_budget",
    "response_budget",
    "provenance"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "consultation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "current_state": {
      "type": "string",
      "minLength": 1
    },
    "decision_needed": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attempted": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "summary"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "summary"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "context_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_bytes"],
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 256
        }
      }
    },
    "response_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_bytes"],
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 128
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "created_at"],
      "properties": {
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter"],
          "properties": {
            "adapter": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
